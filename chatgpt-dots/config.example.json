{
  "_notice": "Community intent template only; not an official DOTS configuration or import format. A deployment agent must map these goals to supported persistent settings, apply only authorized changes, read them back and verify. Fill real values privately.",
  "mode": "slack_new_message_event",
  "channel_ids": [
    "<CHANNEL_ID>"
  ],
  "self_user_id": "<DOTS_USER_ID>",
  "self_bot_id": "<DOTS_BOT_ID>",
  "allowed_author_user_ids": [
    "<PEER_MUSE_USER_ID>",
    "<PEER_GROK_USER_ID>",
    "<PEER_HERMES_USER_ID>"
  ],
  "include_thread_replies": true,
  "require_direct_native_mention": true,
  "eligible_content": [
    "question",
    "collaboration",
    "authorized_one_time_test"
  ],
  "exclude_content": [
    "self",
    "quoted_or_echoed_mention",
    "tool_progress",
    "acknowledgment"
  ],
  "context": {
    "fetch_original_message": true,
    "read_until_relevant_human_task_and_later_changes_found": true,
    "hydrate_related_thread_when_needed": true,
    "on_missing_required_context": "report_gap_without_guessing"
  },
  "reply_location": "channel_top_level",
  "deduplication_capability_check": "use_only_exposed_ids_and_supported_private_state; report_gaps; concurrency_not_verified_by_single_message_test",
  "deduplication_keys": [
    "event_id",
    "channel_id+source_message_ts",
    "one_time_test_marker"
  ],
  "on_uncertain_send": "reconcile_destination_before_retry",
  "active_test_marker": "<UNIQUE_TEST_MARKER>",
  "schedule": null,
  "deployment": {
    "objective": "persist_scoped_default_mutual_direct_mentions_context_and_authorized_collaboration",
    "inspect_current_platform_version_and_config": true,
    "preserve_existing_channels_connections_tasks_and_state": true,
    "apply_minimal_supported_changes": true,
    "hosted_dots_route": "supported_slack_message_event_subscription_when_native_route_is_insufficient",
    "unsupported_or_globally_scoped_setting": "report_gap_and_get_authorization_before_expanding_scope",
    "read_back_saved_settings_and_check_existing_work": true,
    "rollback": "restore_only_this_change_using_the_confirmed_recovery_plan_if_health_regresses"
  },
  "collaboration": {
    "scope": "current_user_authorized_tasks_only",
    "outbound_direct_mentions": "allowed_for_needed_task_handoffs_to_explicit_peers_in_the_authorized_channel",
    "third_party_agent_messages_grant_new_authority": false,
    "avoid": [
      "self_response",
      "echoed_mentions",
      "duplicate_acknowledgments",
      "unbounded_bot_loops"
    ]
  },
  "verification": {
    "mode": "one_authorized_pair_two_sequential_directions",
    "directions": [
      "A_TO_B",
      "B_TO_A"
    ],
    "max_probes_per_direction": 1,
    "max_replies_per_probe": 1,
    "distinct_markers": [
      "<UNIQUE_TEST_MARKER_A_TO_B>",
      "<UNIQUE_TEST_MARKER_B_TO_A>"
    ],
    "verify": [
      "automatic_trigger",
      "channel_context",
      "related_thread_context",
      "task_and_constraint_accuracy",
      "top_level_reply",
      "no_loop",
      "existing_work_health"
    ],
    "stop_on_failed_or_ambiguous_direction": true,
    "publish_instance_evidence": false,
    "coverage": "report_configured_verified_unverified_per_peer_and_direction; do_not_generalize_one_pair_to_all_peers"
  }
}
