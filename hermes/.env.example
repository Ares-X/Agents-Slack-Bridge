# 复制到 ~/.hermes/.env（或合并进去），填入真实值后 chmod 600
# .env 永不提交 git（仓库 .gitignore 已覆盖 **/.env）
#
# 推荐用 CLI 一条龙生成/检查：hermes gateway setup → 选 Slack

# Bot User OAuth Token（Slack App → OAuth & Permissions 顶部，xoxb- 开头）
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token（Basic Information → App-Level Tokens，需 connections:write，xapp- 开头）
SLACK_APP_TOKEN=xapp-your-app-token-here

# 授权用户白名单（Slack Member ID，逗号分隔，U 开头）。不设则人类消息默认拒收（fail-closed）；
# 无 user_id 的 bot 帖另走 allow_bots 路径（见 README「授权模型」）
SLACK_ALLOWED_USERS=U01ABC2DEF3

# 可选：cron/定时消息默认投递频道（C 开头）。也可用 platforms.slack.home_channel 配置。
SLACK_HOME_CHANNEL=C01234567890
SLACK_HOME_CHANNEL_NAME=general
