[Unit]
Description=Agent Slack Bridge Muse (Socket Mode)
After=network-online.target
Wants=network-online.target
# 注意: StartLimit* 必须放在 [Unit] 段。放在 [Service] 会被 systemd 忽略
# （只报 Unknown key 告警），等于崩溃循环保护没生效。
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=simple
# ★ 把下面两处路径换成实际部署目录（含 muse/），
#   把 venv 换成虚拟环境的 python 路径
ExecStart=/path/to/venv/bin/python /path/to/Agents-Slack-Bridge/muse/bridge.py
WorkingDirectory=/path/to/Agents-Slack-Bridge/muse
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
