# 复制为 .env 并填入真实值：  cp .env.example .env && chmod 600 .env
# 注意：.env 绝不提交到 git（已在 .gitignore 中）

# Bot User OAuth Token（Slack App → OAuth & Permissions，xoxb- 开头）
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token（Slack App → Basic Information → App-Level Tokens，需 connections:write，xapp- 开头）
SLACK_APP_TOKEN=xapp-your-app-token-here

# 可选：出站代理（直连留空）
# PROXY_URL=http://proxy.example.com:3128

# 可选：自签/TLS 拦截代理的 CA bundle 路径（系统默认 CA 够用就留空）
# CA_BUNDLE=/path/to/ca-bundle.pem

# 多 agent 协作（默认已开启，无需配置）：
# 其他 bot 的 @mention 默认放行（自己的消息永远过滤防自循环）。
# 可选白名单收紧：两者都留空 = 允许任意其他 bot；任一非空 = 仅放行列出的 ID。
# ALLOWED_BOT_USERS=U1111111111,U2222222222
# ALLOWED_BOT_IDS=B1111111111,B2222222222

# 可选：本 bot 的 Slack user ID（U 开头）。留空则 bridge 用 auth_test。
# SLACK_BOT_USER_ID=U0000000000

# 可选：本 bot 的 bot ID（B 开头），用于发送结果核验时确认"是我们自己发的"。
# 在 Slack App → Basic Information → App Credentials 附近或任意一次
# conversations.history 里本 bot 消息的 bot_id 字段可查到。
# 留空则只按 user ID 匹配；两者都拿不到时核验永远无法确认（保持 uncertain，
# 绝不猜测成功）。
# SLACK_BOT_ID=B0000000000

